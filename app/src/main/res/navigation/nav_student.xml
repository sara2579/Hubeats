<?xml version="1.0" encoding="utf-8"?>

<!-- student side's navigation map (GAMAR).
Zuni adds her 3 screens here too. -->

<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:id="@+id/nav_student"
    app:startDestination="@id/myOrdersFragment">
    <!-- startDestination = the first screen shown.
         TEMPORARILY My Orders, coz Zuni's restaurant list doesn't exist yet.
         When her screens are added, change this to @id/restaurantListFragment. -->

    <!-- ZUNI'S SCREENS GO HERE: restaurantListFragment, menuFragment, cartFragment -->

    <!-- Screen: My Orders -->
    <fragment
        android:id="@+id/myOrdersFragment"
        android:name="com.hubeats.app.ui.student.MyOrdersFragment"
        android:label="@string/title_my_orders">
        <!-- android:name = the Kotlin class that draws this screen.
        starts at my orders fragment, it will display this screen
             android:label = the title shown in the toolbar-->

        <!-- An "action" is an arrow: from this screen to Order details -->
        <action
            android:id="@+id/action_myOrders_to_orderDetail"
            app:destination="@id/orderDetailFragment" />
    </fragment>

    <!-- Screen: Order details + timeline -->
    <fragment
        android:id="@+id/orderDetailFragment"
        android:name="com.hubeats.app.ui.student.OrderDetailFragment"
        android:label="@string/title_order_detail">

        <!-- This screen needs to know WHICH order to show,
             so My Orders gives it a number called orderId. -->
        <argument
            android:name="orderId"
            app:argType="integer" />
    </fragment>

</navigation>