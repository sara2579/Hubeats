<?xml version="1.0" encoding="utf-8"?>

<!-- One order in the My Orders list (GAMAR) -->
<!-- MaterialCardView = a rounded card.
clickable so it reacts to a tap. -->

<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="6dp"
    android:clickable="true"
    android:focusable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Top line: order number on the left, status chip on the right -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- layout_weight="1" = take all spare width, pushing the chip to the right -->
            <TextView
                android:id="@+id/text_order_number"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceTitleMedium"
                tools:text="Order #4" />

            <!-- A Chip is the small rounded label. Not clickable: it only shows the status. -->
            <com.google.android.material.chip.Chip
                android:id="@+id/chip_status"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                tools:text="In Progress" />
        </LinearLayout>

        <!-- Second line: restaurant and time -->
        <TextView
            android:id="@+id/text_restaurant_time"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            tools:text="Hardee's · 11:05 AM" />
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>